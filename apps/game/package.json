{
  "name": "@realms/game",
  "description": "Browser client of Realms of the Chaos (PixiJS 8 + booyah)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --port 1234 ./index.html",
    "build": "bun build ./index.html --outdir dist --minify --sourcemap=linked --env=PUBLIC_*",
    "preview": "bun --port 1234 ./dist/index.html",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@ghom/booyah": "^1.3.0",
    "@realms/adventure": "workspace:*",
    "@realms/engine": "workspace:*",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "happy-dom": "^21.0.4"
  }
}
