{
  "name": "realms-of-the-chaos",
  "description": "HTML5 tactical RPG on an isometric grid",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --port 1234 ./index.html",
    "build": "bun build ./index.html --outdir dist --minify --sourcemap=linked",
    "preview": "bun --port 1234 ./dist/index.html",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "format": "prettier --write src",
    "share": "cloudflared tunnel --url http://localhost:1234"
  },
  "prettier": {
    "semi": false
  },
  "dependencies": {
    "@ghom/booyah": "^1.3.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@ghom/utils": "^1.1.5"
  }
}
