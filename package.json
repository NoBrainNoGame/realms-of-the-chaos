{
  "name": "realms-of-the-chaos",
  "description": "HTML5 tactical RPG on an isometric grid",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "biome check && turbo run typecheck test",
    "format": "biome format --write",
    "balance": "bun packages/engine/scripts/balance.ts",
    "lint": "biome check",
    "spells:fit": "bun packages/engine/scripts/spells-fit.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.4.4",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@ghom/utils": "^1.1.5"
  }
}
