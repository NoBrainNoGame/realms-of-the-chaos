{
  "name": "realms-of-the-chaos",
  "description": "HTML5 tactical RPG on an isometric grid",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test",
    "format": "prettier --write \"apps/*/src/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "balance": "bun packages/engine/scripts/balance.ts"
  },
  "prettier": {
    "semi": false
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@ghom/utils": "^1.1.5"
  }
}
